#!/usr/bin/env bash
# review - wrapper command for user's nvim runtime with review-anchor lua addon
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

TARGET=""
if [ $# -gt 0 ]; then
  TARGET="$1"
  shift
elif [ -f "$SCRIPT_DIR/review-anchor/implementation_plan.md" ]; then
  TARGET="$SCRIPT_DIR/review-anchor/implementation_plan.md"
elif [ -f "$SCRIPT_DIR/implementation_plan.md" ]; then
  TARGET="$SCRIPT_DIR/implementation_plan.md"
else
  TARGET="review.md"
fi

PLUGIN_DIR="$SCRIPT_DIR/review-anchor"

exec nvim \
  --cmd "set rtp^=$PLUGIN_DIR" \
  -c "setlocal wrap linebreak breakindent" \
  -c "lua require('review_anchor').start([[$TARGET]])" \
  "$TARGET" "$@"
